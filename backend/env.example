# SEI Sentinel Backend Environment Configuration

# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Sei MCP Server Configuration
SEI_MCP_URL=http://localhost:3001
AGENT_NFT_CONTRACT=0xYourAgentNFTContractAddress

# Sei Network Configuration
SEI_NETWORK=sei-testnet
SEI_RPC_URL=https://rpc-testnet.sei.io

# Optional: Database Configuration (if using a real database)
# DATABASE_URL=postgresql://user:password@localhost:5432/sei_sentinel

# Optional: API Keys (if needed)
# OPENAI_API_KEY=your_openai_api_key
# GOAT_API_KEY=your_goat_api_key
